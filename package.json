{
  "name": "vibra-api",
  "version": "1.0.0",
  "description": "Vibra API",
  "author": "Vibra Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start-env": "npm run start:dev && node --env-file=.env",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "audit:serials": "node scripts/audit-permission-serials.mjs",
    "diagnose:media": "node --env-file-if-exists=.env scripts/diagnose-media.mjs",
    "diagnose:f5": "node --env-file-if-exists=.env scripts/diagnose-f5.mjs",
    "migrate:serials": "node --env-file-if-exists=.env scripts/migrate-permission-serials.mjs",
    "seed:serials": "ts-node -T src/database/seeds/seed-permission-serial-contract.ts",
    "verify": "npm run audit:serials && npm test -- --ci && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/mapped-types": "*",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^12.2.0",
    "@sendgrid/mail": "^8.1.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "^4.4.0",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "gridfs-stream": "^1.1.1",
    "ioredis": "^5.6.0",
    "log4js": "^6.9.1",
    "moment": "^2.30.1",
    "mongoose": "^8.10.1",
    "mssql": "^11.0.1",
    "multer": "^2.0.2",
    "multer-gridfs-storage": "^3.3.0",
    "nest-winston": "^1.9.7",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.12.3",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "uuid": "^11.0.5",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.0.0",
    "@types/cron": "^2.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  }
}
